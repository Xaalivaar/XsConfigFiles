# ==============================================================================
# i3wm Configuration File
# Replicates dwm-style workflow and keybindings
# ==============================================================================

# Modifier key: Mod4 = Windows / Super key
set $mod Mod4

# Font configuration
font pango:ttf-noto-nerd 11

# ==============================================================================
# Autostart & System Services
# ==============================================================================
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id xcompmgr
exec --no-startup-id pasystray
exec --no-startup-id /usr/bin/setxkbmap -option "caps:swapescape"
exec --no-startup-id ~/.config/polybar/colorblocks/scripts/pywal.sh ~/Downloads/Wallpapers/'5 Wallpapers Per Second'/1.jpg

# ==============================================================================
# Mouse & Floating Window Behavior
# ==============================================================================
# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# Move tiling windows via drag & drop by left-clicking titlebar
tiling_drag modifier titlebar

# ==============================================================================
# Audio & Media Controls
# ==============================================================================
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# ==============================================================================
# Application Launchers (from dwm config.h)
# ==============================================================================
bindsym $mod+Return exec xfce4-terminal
bindsym $mod+Shift+w exec firefox
bindsym $mod+Shift+f exec thunar
bindsym $mod+s exec flameshot gui
bindsym $mod+Shift+o exec /home/kuro/AppImages/Obsidian-1.12.7.AppImage
bindsym $mod+Shift+p exec ~/.local/bin/rofi-pdf-browser
bindsym $mod+x exec ~/.config/bspwm/scripts/power
bindsym $mod+m exec mpc toggle
bindsym Ctrl+Mod1+r exec xfce4-terminal -e ranger

# Application launcher (dmenu with dwm palette)
bindsym $mod+d exec dmenu_run -m 0 -fn "monospace:size=10" -nb "#222222" -nf "#bbbbbb" -sb "#a0a484" -sf "#eeeeee"

# ==============================================================================
# Window Focus & Navigation (dwm: focusstack & rotatestack)
# ==============================================================================
# Close active window (dwm: killclient)
bindsym $mod+c kill

# Cycle focus (dwm: focusstack)
bindsym $mod+j focus down
bindsym $mod+k focus up

# Move window position (dwm: rotatestack)
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up

# Promote window / shift to master side (dwm: zoom)
bindsym $mod+Shift+Return move left

# Direct split resizing without entering resize mode (dwm: setmfact)
bindsym $mod+h resize shrink width 5 px or 5 ppt
bindsym $mod+l resize grow width 5 px or 5 ppt

# Fallback arrow navigation
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ==============================================================================
# Layout & Window State (dwm layouts)
# ==============================================================================
# Toggle split / tiling (dwm: tile)
bindsym $mod+t layout toggle split

# Fullscreen / Monocle toggle (dwm: monocle)
bindsym $mod+f fullscreen toggle

# Toggle floating state
bindsym $mod+Shift+space floating toggle

# Switch focus between floating and tiled windows
bindsym $mod+space focus mode_toggle

# Toggle bar visibility (dwm: togglebar)
bindsym $mod+b bar mode toggle

# Workspace back-and-forth toggle (dwm: view {0} / Mod+Tab)
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth

# ==============================================================================
# Multi-Monitor Management (dwm: focusmon & tagmon)
# ==============================================================================
bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

# ==============================================================================
# Workspaces (Tags 1-9 & 0)
# ==============================================================================
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ==============================================================================
# System, Session & Config Reloads
# ==============================================================================
# Reload config
bindsym $mod+Shift+c reload

# Restart i3 in place
bindsym $mod+Shift+r restart

# Exit i3 session (dwm: Mod4 + Alt + q)
bindsym $mod+Mod1+q exec "i3-nagbar -t warning -m 'Exit i3 session?' -B 'Yes, exit' 'i3-msg exit'"

# ==============================================================================
# Sizing, Gaps & Appearance
# ==============================================================================
gaps inner 5
gaps outer -2

# Colors from Xresources / pywal
set_from_resource $fg i3wm.color7 #f0f0f0
set_from_resource $bgAct i3wm.color2 #f0f0f0
set $bg #090909

# Window border styles
# class                 border  backgr. text    indicator child_border
client.focused          $bgAct  $bgAct  $fg     $bgAct    $bgAct
client.focused_inactive $bg     $bg     $fg     $bg       $bg
client.unfocused        $bg     $bg     $fg     $bg       $bg
client.urgent           $bg     $bg     $fg     $bg       $bg
client.placeholder      $bg     $bg     $fg     $bg       $bg
client.background       $bg

# ==============================================================================
# Bar Configuration
# ==============================================================================
bar {
    status_command i3status
    colors {
        background $bg
        statusline $fg
        separator $fg
        focused_workspace $bg $bgAct $fg
    }
}